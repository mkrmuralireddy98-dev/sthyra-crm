{
  "name": "@plumb/observability",
  "version": "0.1.0",
  "private": true,
  "description": "Plumb observability — structured logging, request-id propagation, OTel-ready hooks",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --test --import tsx/esm src/**/*.test.ts",
    "lint": "echo 'lint: covered by root config'",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@plumb/tokens": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "fastify": "^5.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
