%%{init: {"theme": "base", "themeVariables": {"primaryColor": "#0A0D13", "primaryTextColor": "#F2F4F7", "primaryBorderColor": "#00B894", "lineColor": "#00B894", "secondaryColor": "#161A22", "tertiaryColor": "#262C36", "fontFamily": "Helvetica, Arial, sans-serif", "fontSize": "14px"}}}%%
flowchart TB
    classDef actor fill:#262C36,stroke:#00B894,color:#F2F4F7
    classDef svc fill:#161A22,stroke:#00B894,color:#F2F4F7
    classDef decide fill:#262C36,stroke:#F5A524,color:#F2F4F7
    classDef store fill:#1F242C,stroke:#F5A524,color:#F2F4F7

    User["👤 User<br/>(mobile or web)"]:::actor

    Start(["Login attempt"]):::decide
    Idp{{"IdP: Okta / Entra / Auth0"}}
    Code["OIDC authorization code"]:::svc
    Token["Exchange code → ID + access token<br/>(Cognito user pool)"]
    JWT["JWT: sub, email, org_id, role,<br/>tenant_id, exp"]:::svc

    Check{{"API Gateway validates:<br/>· signature (JWKS)<br/>· expiry<br/>· audience"}}
    Deny["401 problem+json<br/>with trace_id"]:::decide
    Store[("Principal cached in Redis<br/>TTL 5 min")]:::store

    Rbac{{"Service RBAC check:<br/>req.principal.role vs<br/>required role"}}
    Forbid["403 problem+json"]:::decide
    Proceed["✅ Proceed to handler<br/>req.principal populated"]:::svc

    Start --> Idp
    Idp -->|"redirect w/ code"| Code
    Code --> Token
    Token --> JWT
    JWT --> Check
    Check -->|invalid| Deny
    Check -->|valid| Store
    Store --> Rbac
    Rbac -->|no permission| Forbid
    Rbac -->|ok| Proceed

    Note["Developer note:<br/>· @plumb/auth plugin does steps 6–9<br/>· Idempotency-Key honored on mutating routes<br/>· x-request-id propagated end-to-end"]

    style Note fill:#0A0D13,stroke:#F5A524,color:#F5A524,stroke-width:1px,stroke-dasharray:3 3
    style User fill:#262C36,stroke:#00B894,color:#F2F4F7
    style Idp fill:#262C36,stroke:#F5A524,color:#F2F4F7
    style Check fill:#262C36,stroke:#F5A524,color:#F2F4F7
    style Rbac fill:#262C36,stroke:#F5A524,color:#F2F4F7
