%%{init: {"theme": "base", "themeVariables": {"primaryColor": "#0A0D13", "primaryTextColor": "#F2F4F7", "primaryBorderColor": "#00B894", "lineColor": "#00B894", "secondaryColor": "#161A22", "tertiaryColor": "#262C36", "fontFamily": "Helvetica, Arial, sans-serif", "fontSize": "14px"}}}%%
flowchart TB
    classDef input fill:#262C36,stroke:#00B894,color:#F2F4F7
    classDef gpu fill:#161A22,stroke:#F5A524,color:#F2F4F7
    classDef out fill:#1F242C,stroke:#4FDDB6,color:#F2F4F7

    CAP[("Captures<br/>(poses + frames)")]:::input
    BIM[("BIMModel<br/>(IFC/glTF)")]:::input
    FP[("Floorplan<br/>(2D vector)")]:::input

    DINO["GPU: DINOv2 ViT-L/14<br/>shared embedding space<br/>(frames + plan + BIM)"]:::gpu
    MATCH["Geometric matching:<br/>PnP w/ floorplan priors<br/>+ visual relocalization"]:::gpu
    ALIGN["Align to BIM:<br/>ICP + k-d tree"]:::gpu
    CONF["Per-element confidence<br/>+ β-distributed CI"]:::gpu
    OUT[("ProgressSnapshot<br/>percent-complete per trade/floor<br/>+ uncertainty bounds")]:::out

    CAP --> DINO
    FP --> DINO
    DINO --> MATCH
    BIM --> ALIGN
    MATCH --> ALIGN
    ALIGN --> CONF
    CONF --> OUT

    Note["Quality gate: percent-complete accuracy<br/>±3% abs / ±5% rel vs hand-counted baseline.<br/>Reproducible: seeded runs, artifacts persisted."]

    style Note fill:#0A0D13,stroke:#F5A524,color:#F5A524,stroke-width:1px,stroke-dasharray:3 3
