flowchart TB
    classDef region fill:#0A0D13,stroke:#00B894,color:#00B894,stroke-dasharray:5 5
    classDef cluster fill:#161A22,stroke:#00B894,color:#F2F4F7
    classDef db fill:#1F242C,stroke:#F5A524,color:#F2F4F7
    classDef storage fill:#1F242C,stroke:#F5A524,color:#F2F4F7
    classDef gw fill:#262C36,stroke:#F5A524,color:#F2F4F7
    classDef gov fill:#262C36,stroke:#F5A524,color:#F2F4F7

    R53["🌐 Route 53<br/>latency-based routing"]:::gw

    subgraph USE1["us-east-1 · PRIMARY"]
        EKS1["EKS: plumb-control<br/>+ plumb-realtime<br/>+ plumb-gpu"]:::cluster
        RDS1["🗄️ RDS Aurora<br/>PRIMARY<br/>(writer + 2 standby)"]:::db
        S3USE1["🪣 S3 raw-360<br/>active"]:::storage
    end

    subgraph USW2["us-west-2 · warm DR"]
        EKS2["EKS: plumb-control"]:::cluster
        RDS2["🗄️ RDS Global DB<br/>read replica<br/>RPO ≤ 1s"]:::db
        S3USW2["🪣 S3 CRR"]:::storage
    end

    subgraph EUW1["eu-west-1 · EU GDPR"]
        EKS3["EKS: plumb-control<br/>(EU-resident)"]:::cluster
        RDS3["🗄️ RDS Global DB<br/>read replica<br/>(tenant-pinned)"]:::db
        S3EUW1["🪣 S3 CRR<br/>(EU-resident)"]:::storage
    end

    subgraph APSE2["ap-southeast-2"]
        EKS4["EKS: plumb-control"]:::cluster
    end

    subgraph APNE1["ap-northeast-1"]
        EKS5["EKS: plumb-control"]:::cluster
    end

    subgraph KSAC1["ksa-central-1 · KSA PDPL"]
        EKS6["EKS: plumb-control"]:::cluster
    end

    subgraph USGE1["us-gov-east-1 · FedRAMP — ISOLATED"]
        EKSGOV["EKS GovCloud"]:::gov
        RDSGOV["🗄️ RDS GovCloud<br/>(separate KMS,<br/>no transit peering)"]:::db
        S3GOV["🪣 S3 GovCloud<br/>Object Lock<br/>(separate keys)"]:::storage
    end

    R53 --> EKS1
    R53 --> EKS2
    R53 --> EKS3
    R53 --> EKS4
    R53 --> EKS5
    R53 --> EKS6

    RDS1 <-->|"Aurora Global DB<br/>(RPO ≤ 1s)"| RDS2
    RDS1 <-->|"Aurora Global DB"| RDS3

    S3USE1 <-->|"S3 CRR"| S3USW2
    S3USE1 <-->|"S3 CRR"| S3EUW1

    Note["🚫 us-gov-east-1 has NO transit peering to commercial.<br/>🚫 KMS keys are NOT shared across the boundary.<br/>🚫 Aurora Global DB does NOT span GovCloud.<br/>✅ FedRAMP Moderate authorization is in progress (Phase 2)."]

