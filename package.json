{
  "name": "sthyra-crm",
  "version": "0.1.0",
  "private": true,
  "description": "Sthyra CRM — Visual Intelligence for the Built World",
  "packageManager": "pnpm@11.5.2",
  "scripts": {
    "build": "pnpm -r --filter=./packages/* --filter=./services/* build",
    "test": "pnpm -r --filter=./packages/* --filter=./services/* --filter=./apps/* test",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,json,md,yml,yaml}\"",
    "typecheck": "pnpm -r --filter=./packages/* --filter=./services/* typecheck"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.4.0",
    "typescript-eslint": "^8.18.0"
  },
  "engines": {
    "node": ">=22"
  }
}
