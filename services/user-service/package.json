{
  "name": "@plumb/user-service",
  "version": "0.1.0",
  "private": true,
  "description": "Plumb User Service — identity, OIDC-shaped tokens, RBAC",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --test --import tsx/esm src/**/*.test.ts",
    "lint": "echo 'service lint: covered by root eslint config'",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start:inmem": "node dist/cli.js"
  },
  "dependencies": {
    "@plumb/observability": "workspace:*",
    "@plumb/tokens": "workspace:*",
    "fastify": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
