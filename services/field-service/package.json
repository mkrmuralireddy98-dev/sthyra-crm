{
  "name": "@sthyra-crm/field-service",
  "version": "0.1.0",
  "private": true,
  "description": "Sthyra CRM Field Service — issue tracking tied to 3D captures",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --experimental-specifier-resolution=node --import tsx --test src/**/*.test.ts src/**/**/*.test.ts src/**/**/**/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/cli.js"
  },
  "dependencies": {
    "@sthyra-crm/observability": "workspace:*",
    "fastify": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
